    "move.push.0.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place your palms at shoulder height on a sturdy wall."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双手与肩同高，撑在稳固墙面上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙手與肩同高，撐在穩固牆面上。"
          }
        }
      }
    },
    "move.push.0.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step back and keep a straight line from shoulders to heels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双脚后退，肩到脚跟保持一条直线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙腳往後退，肩到腳跟維持一直線。"
          }
        }
      }
    },
    "move.push.0.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend your elbows to bring your chest toward the wall, then press away."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屈肘让胸口靠近墙面，再推回起始姿势。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "屈肘讓胸口靠近牆面，再推回起始姿勢。"
          }
        }
      }
    },
    "move.push.1.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place your hands on a stable bench or counter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双手撑住稳固的长凳或台面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙手撐住穩固的長凳或檯面。"
          }
        }
      }
    },
    "move.push.1.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step back until shoulders, hips, and ankles line up."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向后撤步，肩、髋、脚踝保持在一条线上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "往後退一步，肩、髖、腳踝維持一直線。"
          }
        }
      }
    },
    "move.push.1.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower your chest toward the edge with elbows angled back, then press up."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "肘向斜后方弯曲，胸口靠近台沿，再推起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手肘朝斜後方彎曲，胸口靠近檯面邊緣，再推起。"
          }
        }
      }
    },
    "move.push.2.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start on toes with your hands just wider than shoulders."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用脚尖撑地，双手比肩略宽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用腳尖撐地，雙手比肩略寬。"
          }
        }
      }
    },
    "move.push.2.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brace your middle and lower chest and hips together."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收紧核心，让胸口和髋部一起下降。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收緊核心，讓胸口和髖部一起下降。"
          }
        }
      }
    },
    "move.push.2.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the floor away and return to straight arms."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推地回到手臂伸直的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推地回到手臂伸直的位置。"
          }
        }
      }
    },
    "move.push.3.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your toes on a low, steady platform and hands on the floor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚尖放在低而稳的平台上，双手撑地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "腳尖放在低而穩的平台上，雙手撐地。"
          }
        }
      }
    },
    "move.push.3.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your hips in line with your shoulders and feet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让髋部与肩、脚保持在一条线上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓髖部與肩、腳維持一直線。"
          }
        }
      }
    },
    "move.push.3.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower smoothly between your hands, then press back up."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身体平稳降到双手之间，再推回上方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "身體平穩降到雙手之間，再推回上方。"
          }
        }
      }
    },
    "move.pull.0.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grip a stable overhead bar with both hands."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双手握牢稳固的头顶横杠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙手握牢穩固的頭頂橫桿。"
          }
        }
      }
    },
    "move.pull.0.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let your arms lengthen and lift your feet off the floor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "伸长手臂，让双脚离地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伸長手臂，讓雙腳離地。"
          }
        }
      }
    },
    "move.pull.0.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your body quiet and breathe while you hold."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身体保持稳定，悬挂时自然呼吸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "身體保持穩定，懸吊時自然呼吸。"
          }
        }
      }
    },
    "move.pull.1.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a stable step and keep a foot on it for support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用稳固踏台，留一只脚踩在台上辅助。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用穩固踏台，留一隻腳踩在台上輔助。"
          }
        }
      }
    },
    "move.pull.1.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull your elbows down and assist only as much as needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手肘向下拉，脚只提供需要的助力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手肘往下拉，腳只提供需要的助力。"
          }
        }
      }
    },
    "move.pull.1.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower under control until your arms are long again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制身体下降，直到手臂重新伸长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制身體下降，直到手臂重新伸長。"
          }
        }
      }
    },
    "move.pull.2.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a stable step to reach the top position with chin above the bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "借稳固踏台到达下巴高于横杠的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "借助穩固踏台到達下巴高於橫桿的位置。"
          }
        }
      }
    },
    "move.pull.2.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift your feet away from the step before lowering."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下降前让双脚离开踏台。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下降前讓雙腳離開踏台。"
          }
        }
      }
    },
    "move.pull.2.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower steadily until your arms are long, then step down."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匀速降到手臂伸长，再落脚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "均勻降到手臂伸長，再落腳。"
          }
        }
      }
    },
    "move.pull.3.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grip the bar about shoulder-width apart and start from a still hang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双手约与肩同宽握杠，从静止悬挂开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙手約與肩同寬握桿，從靜止懸吊開始。"
          }
        }
      }
    },
    "move.pull.3.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw elbows toward your ribs until your chin clears the bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "肘往肋侧拉，直到下巴越过横杠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手肘往肋骨兩側拉，直到下巴越過橫桿。"
          }
        }
      }
    },
    "move.pull.3.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower with control and reset before the next rep."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制下降，回到稳定姿势再做下一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制下降，回到穩定姿勢再做下一次。"
          }
        }
      }
    },
    "move.squat.0.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit near the front of a stable chair with both feet flat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坐在稳定椅面前侧，双脚平踩地面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "坐在穩固椅面前方，雙腳平踩地面。"
          }
        }
      }
    },
    "move.squat.0.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean slightly forward and push through both feet to stand."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上身微微前倾，双脚踩稳发力站起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上身微微前傾，雙腳踩穩發力站起。"
          }
        }
      }
    },
    "move.squat.0.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send hips back and sit down slowly to reset."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "髋向后移，慢慢坐回椅面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "髖部往後移，慢慢坐回椅面。"
          }
        }
      }
    },
    "move.squat.1.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand just in front of a steady chair with feet about shoulder-width apart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站在稳固椅子前，双脚约与肩同宽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "站在穩固椅子前，雙腳約與肩同寬。"
          }
        }
      }
    },
    "move.squat.1.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend hips and knees until you lightly touch the seat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屈髋屈膝，直到臀部轻触椅面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "屈髖屈膝，直到臀部輕觸椅面。"
          }
        }
      }
    },
    "move.squat.1.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep weight on your feet and stand back up smoothly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把重心留在双脚上，平稳站起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把重心留在雙腳上，平穩站起。"
          }
        }
      }
    },
    "move.squat.2.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your whole foot on the floor and let toes turn out slightly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双脚全掌踩地，脚尖可略向外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙腳全掌踩地，腳尖可略朝外。"
          }
        }
      }
    },
    "move.squat.2.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend hips and knees together, with knees moving in the direction of toes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "髋和膝一起屈曲，膝盖朝脚尖方向移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "髖和膝一起屈曲，膝蓋朝腳尖方向移動。"
          }
        }
      }
    },
    "move.squat.2.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower as far as you can stay balanced, then stand tall."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "降到能保持平衡的深度，再站直。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "降到能維持平衡的深度，再站直。"
          }
        }
      }
    },
    "move.squat.3.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set one foot ahead of the other and keep both feet in place."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双脚一前一后站稳，动作中保持脚位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙腳一前一後站穩，動作中維持腳位。"
          }
        }
      }
    },
    "move.squat.3.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend both knees and lower the rear knee toward the floor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两膝弯曲，后膝向地面下降。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩膝彎曲，後膝朝地面下降。"
          }
        }
      }
    },
    "move.squat.3.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press through the front foot to rise, then repeat on the other side."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前脚踩稳发力站起，完成后换边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前腳踩穩發力站起，完成後換邊。"
          }
        }
      }
    },
    "move.hold.0.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place your hands on a steady wall at shoulder height."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双手在肩高处撑住稳固墙面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙手在肩高處撐住穩固牆面。"
          }
        }
      }
    },
    "move.hold.0.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step back until your head, hips, and heels line up."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚向后退，让头、髋、脚跟排成直线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "腳往後退，讓頭、髖、腳跟排成直線。"
          }
        }
      }
    },
    "move.hold.0.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the angle and keep breathing naturally."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持身体角度，自然呼吸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "維持身體角度，自然呼吸。"
          }
        }
      }
    },
    "move.hold.1.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place your palms on a stable elevated surface."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双手撑在稳固的高台上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙手撐在穩固的高檯上。"
          }
        }
      }
    },
    "move.hold.1.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step back, straighten your arms, and keep your hips level."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向后撤步，伸直手臂，保持髋部平稳。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "往後退一步，伸直手臂，保持髖部平穩。"
          }
        }
      }
    },
    "move.hold.1.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your body in one line while breathing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持身体成一条线，持续呼吸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "維持身體成一直線，持續呼吸。"
          }
        }
      }
    },
    "move.hold.2.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start on forearms and knees with elbows under shoulders."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前臂和膝盖着地，肘在肩正下方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前臂和膝蓋著地，手肘在肩正下方。"
          }
        }
      }
    },
    "move.hold.2.tip.2": {
      "extractionState": "manual",
